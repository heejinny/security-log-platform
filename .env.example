# =============================================================
#  환경변수 템플릿
#  사용법: 이 파일을 복사해서 .env 로 만들고 실제 값을 채운다.
#      cp .env.example .env
#  .env 는 .gitignore 에 의해 저장소에 올라가지 않는다.
# =============================================================

# --- OpenAI (Step 6에서 사용) ---
OPENAI_API_KEY=sk-여기에-실제-키
OPENAI_MODEL=gpt-4o-mini

# --- Discord Webhook (Step 7에서 사용) ---
# Discord 채널 설정 > 연동 > 웹후크 에서 발급
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# --- n8n 계정 ---
# n8n 2.x는 첫 실행 시 http://localhost:5678 화면에서 관리자(Owner)
# 계정을 직접 만든다. (예전 basic-auth 환경변수는 폐기됨)

# --- 위험도 임계값 (선택: 나중에 튜닝 가능) ---
# 이 값 이상이면 Discord 알림을 보낸다. (예: MEDIUM 이상만 알림)
ALERT_MIN_SCORE=30
